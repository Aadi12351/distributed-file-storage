{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "File Drive: Start locally",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Start.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "File Drive: Show local URL",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-Command", "Get-Content -LiteralPath './logs/frontend.log' -Tail 12"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "File Drive: Build frontend",
      "type": "shell",
      "command": "npm.cmd run build",
      "options": {"cwd": "${workspaceFolder}/frontend"},
      "problemMatcher": []
    }
  ]
}
