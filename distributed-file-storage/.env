# ================================
# APPLICATION
# ================================
APP_NAME=Distributed File Storage API
APP_VERSION=1.0.0
DEBUG=True

HOST=127.0.0.1
PORT=8000

# ================================
# SECURITY
# ================================
SECRET_KEY=ThisIsMySuperSecretKeyChangeThisInProduction123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ================================
# DATABASE
# ================================
DATABASE_URL=postgresql://postgres:Aadi%40123@localhost:5432/file_storage

# ================================
# AWS S3
# (We'll fill these after creating AWS resources)
# ================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=file-storage-bucket

# ================================
# FILE UPLOAD
# ================================
MAX_FILE_SIZE=104857600
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,docx,txt,zip,mp4

# ================================
# REDIS
# (We'll use this later)
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ================================
# RABBITMQ
# (We'll use this later)
# ================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ================================
# LOGGING
# ================================
LOG_LEVEL=INFO

# ================================
# ENVIRONMENT
# ================================
ENVIRONMENT=development